##################################################
# F4: Latitude Model
# Four-level calibrated uncertainty scale with Census examples
##################################################

direction: right

none: "NONE\n─────────\nHard consensus\n(mandatory)\n\n\"ACS 1-year\nrequires\npop >= 65,000\"" {
  style.fill: "#333333"
  style.font-color: "#FFFFFF"
  style.stroke: "#000000"
  style.border-radius: 8
  style.font-size: 11
}

narrow: "NARROW\n─────────\nStrong agreement\n(rare exceptions)\n\n\"CV > 40% =\nunreliable\"" {
  style.fill: "#0072B2"
  style.font-color: "#FFFFFF"
  style.stroke: "#005A8C"
  style.border-radius: 8
  style.font-size: 11
}

wide: "WIDE\n─────────\nContext-dependent\n(judgment required)\n\n\"1-year vs 5-year\ndepends on\npurpose\"" {
  style.fill: "#56B4E9"
  style.font-color: "#000000"
  style.stroke: "#2F9CC8"
  style.border-radius: 8
  style.font-size: 11
}

full: "FULL\n─────────\nBackground context\n(always mention)\n\n\"ACS replaced\nlong-form census\nin 2005\"" {
  style.fill: "#CCCCCC"
  style.font-color: "#333333"
  style.stroke: "#999999"
  style.border-radius: 8
  style.font-size: 11
}

none -> narrow -> wide -> full: "" {
  style.stroke: "#666666"
  style.stroke-width: 2
}
