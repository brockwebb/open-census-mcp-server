##################################################
# F3: Anatomy of a Pragmatic Context Item
# Example: ACS-MOE-002 (Coefficient of Variation)
# Palette: Census xdgov Data Design Standards
# 508 compliance: all text/background pairs >= 4.5:1
##################################################

item: ACS-MOE-002 {
  grid-rows: 5
  grid-columns: 1
  style.fill: "#E8EFF2"
  style.stroke: "#112E51"
  style.stroke-width: 3
  style.border-radius: 8
  style.font-color: "#112E51"
  style.bold: true
  style.font-size: 18

  ctx: "Context Text\n\nCV = (SE / estimate) x 100.\nCV above 40%: estimate may be too unreliable for most uses." {
    style.fill: "#FFFFFF"
    style.stroke: "#112E51"
    style.stroke-width: 2
    style.border-radius: 6
    style.font-size: 16
    style.font-color: "#112E51"
  }

  lat: "Latitude:  none  |  NARROW  |  wide  |  full\n(Strong professional agreement with rare exceptions)" {
    style.fill: "#C9E8EC"
    style.stroke: "#0095A8"
    style.stroke-width: 2
    style.border-radius: 6
    style.font-size: 16
    style.font-color: "#003B43"
  }

  trig: "Triggers:  margin_of_error  .  reliability  .  coefficient_of_variation" {
    style.fill: "#FFE0D0"
    style.stroke: "#C25432"
    style.stroke-width: 2
    style.border-radius: 6
    style.font-size: 16
    style.font-color: "#5A1800"
  }

  edges: "Thread Edges:  relates_to ACS-MOE-001  .  relates_to ACS-MOE-003" {
    style.fill: "#E8EFF2"
    style.stroke: "#78909C"
    style.border-radius: 6
    style.font-size: 16
    style.font-color: "#222C31"
  }

  prov: "Provenance:  Handbook Ch. 7  |  pipeline (quarry KG)  |  grounded" {
    style.fill: "#E8EFF2"
    style.stroke: "#78909C"
    style.border-radius: 6
    style.font-size: 16
    style.font-color: "#222C31"
  }
}
