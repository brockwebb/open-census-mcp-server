##################################################
# F6: Three-Stage Evaluation Pipeline
# Stage 1 (generation) -> Stage 2 (CQS) -> Stage 3 (fidelity)
##################################################

direction: right

stage1: "STAGE 1\nResponse Generation\n─────────────────\n39 queries x 3 conditions\n= 117 responses\n\nCaller: Sonnet 4.5" {
  style.fill: "#E3F0FB"
  style.stroke: "#0072B2"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 11
  style.font-color: "#003A5C"
}

stage2: "STAGE 2\nConsultation Quality Score\n─────────────────\n3 judge models x 2 orderings\nx 3 comparisons\n= 2,106 records\n\nDims: D1-D5\nHolm-Bonferroni correction" {
  style.fill: "#E3F0FB"
  style.stroke: "#0072B2"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 11
  style.font-color: "#003A5C"
}

stage3: "STAGE 3\nFidelity Verification\n─────────────────\nClaim-level\nfact-checking\nagainst Census API\n\nFidelity %\nError rate\nAuditability" {
  style.fill: "#E3F0FB"
  style.stroke: "#0072B2"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 11
  style.font-color: "#003A5C"
}

stage1 -> stage2 -> stage3
